@page "/people"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Pessoas | Person App</PageTitle>

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Pessoas</h1>
            <p class="text-muted m-0">Gerencie o cadastro de pessoas.</p>
        </div>
        <button class="btn btn-primary" @onclick="NavigateToCreate">
            <span class="bi bi-plus-lg me-2"></span>Nova Pessoa
        </button>
    </div>

    @if (people == null)
    {
        <div class="loading-container">
            <div class="spinner"></div>
        </div>
    }
    else if (people.Length == 0)
    {
        <div class="text-center py-5">
            <div class="text-muted mb-3" style="font-size: 3rem;">
                <i class="bi bi-people"></i>
            </div>
            <h3>Nenhuma pessoa cadastrada</h3>
            <p class="text-muted">Clique em "Nova Pessoa" para começar.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var person in people)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card-modern h-100 d-flex flex-column justify-content-between">
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                                    @(person.Name.Length > 0 ? person.Name[0].ToString().ToUpper() : "?")
                                </div>
                                <h5 class="m-0 text-truncate" title="@person.Name">
                                    @person.Name
                                </h5>
                            </div>
                            <small class="text-muted d-block text-truncate">ID: @person.Id</small>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-auto pt-3 border-top" style="border-color: var(--border-color) !important;">
                             <button class="btn btn-sm btn-outline-light" title="Editar" @onclick="() => NavigateToEdit(person.Id)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Excluir" @onclick="() => DeletePerson(person.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Person[]? people;

    protected override async Task OnInitializedAsync()
    {
        // Simulate loading for effect
        // await Task.Delay(1000); 
        try
        {
            people = await Http.GetFromJsonAsync<Person[]>("person/list");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao buscar pessoas: {ex.Message}");
        }
    }

    public class Person
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/people/create");
    }

    private void NavigateToEdit(Guid id)
    {
        Navigation.NavigateTo($"/people/edit/{id}");
    }

    private async Task DeletePerson(Guid id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Tem certeza que deseja excluir esta pessoa?");
        if (confirmed)
        {
            try
            {
                var response = await Http.DeleteAsync($"person/deleteId/{id}");
                if (response.IsSuccessStatusCode)
                {
                    // Refresh the list
                    people = await Http.GetFromJsonAsync<Person[]>("person/list");
                }
                else
                {
                    Console.WriteLine("Erro ao excluir pessoa.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro: {ex.Message}");
            }
        }
    }
}
